// firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {

      // 【読み込みルール】
      // ユーザーが認証済みの場合にのみ、読み込みを許可する。
      // (WebアプリもiOSアプリも匿名認証を行うため、この条件を満たす)
      allow read: if request.auth != null;

      // 【書き込みルール】
      // ユーザーが認証済みで、かつ 'writer' カスタムクレームを持っている場合にのみ、書き込みを許可する。
      // (このクレームはCloud Function経由でiOSアプリにのみ付与される)
      allow write: if request.auth != null && request.auth.token.writer == true;
    }
  }
}